{
  "appId": "com.lilac.echoes",
  "appName": "lilac echoes",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "hostname": "lilac.app"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  },
